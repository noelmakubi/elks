# Copy to .env on the server and edit. Never commit the real .env.
# docker-compose.yml reads these; no credentials are hardcoded in the repo.
#
# On the EC2 host this file lives at /opt/elks/microservices/.env and is
# gitignored. Generate real passwords with:
#   openssl rand -base64 24
# and do not reuse one value across all three services.

# Logging
LOG_LEVEL=INFO

# service-a database
SERVICE_A_DB_NAME=service_a
SERVICE_A_DB_USER=service_a_user
SERVICE_A_DB_PASSWORD=change_me_service_a

# service-b database
SERVICE_B_DB_NAME=service_b
SERVICE_B_DB_USER=service_b_user
SERVICE_B_DB_PASSWORD=change_me_service_b

# service-c database
SERVICE_C_DB_NAME=service_c
SERVICE_C_DB_USER=service_c_user
SERVICE_C_DB_PASSWORD=change_me_service_c

# Behaviour
# true  -> service-b rejects orders when service-a cannot validate the user_id
# false -> service-b logs a warning and accepts the order (default, keeps
#          service-b independently deployable)
REQUIRE_USER_VALIDATION=false

# How often service-c polls service-b for new orders
POLL_INTERVAL_SECONDS=15

# ---- production overlay only (docker-compose.prod.yml) --------------------
# The dashboard is the only container with a host port. It binds loopback so
# the host nginx is the only way in. Leave as-is unless you have a reason.
UI_BIND=127.0.0.1
UI_PORT=8080

# Gunicorn threads per service. Raise before raising GUNICORN_WORKERS: a second
# worker is a second process and would start a second poller in service-c.
GUNICORN_THREADS=8

# ---------------------------------------------------------------------------
# Production settings. Ignored by docker-compose.yml (dev); read by
# docker-compose.prod.yml. Safe defaults are baked in, so you only need these
# if you want to change something.
# ---------------------------------------------------------------------------

# The tag applied to the locally built images. deploy.sh sets this to the short
# commit sha automatically; override it to pin to a specific build.
# IMAGE_TAG=local

# The dashboard container's host binding.
#   127.0.0.1 -> only reachable from the host's own nginx (correct for prod)
#   0.0.0.0   -> published to the world; only for a quick look without nginx
# UI_BIND=127.0.0.1
# UI_PORT=8080

# Seconds deploy.sh waits for every container to report healthy.
# HEALTH_TIMEOUT=180
